FROM mongo:7

# Copy init scripts (both bash and PowerShell)
COPY scripts/mongo-init.sh /docker-entrypoint-initdb.d/mongo-init.sh
COPY scripts/mongo-init.ps1 /docker-entrypoint-initdb.d/mongo-init.ps1
RUN chmod +x /docker-entrypoint-initdb.d/mongo-init.sh

# Copy dumps for restoration
COPY data/dumps/ /dumps/

EXPOSE 27017
